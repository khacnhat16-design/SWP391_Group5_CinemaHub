# Cinema Management - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQL Server host and instance name
# Examples:
#   - Local default: localhost\SQLEXPRESS
#   - Local default instance: localhost
#   - Remote: 192.168.1.100\SQLEXPRESS
DB_HOST=localhost\SQLEXPRESS

# SQL Server port (default: 1433)
DB_PORT=1433

# Database name (created automatically by schema.sql)
DB_NAME=CinemaManagement

# SQL Server authentication credentials
DB_USER=sa12
DB_PASSWORD=123

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Server port (default: 8080)
# Can also be set via -Dcinema.port=8080 or CINEMA_PORT environment variable
APP_PORT=8080

# =============================================================================
# CLOUDINARY (poster/banner image uploads)
# =============================================================================

# Do not commit the real credentials to source control.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# =============================================================================
# EMAIL (Gmail SMTP)
# =============================================================================

# Enable Gmail SMTP for forgot-password OTP and new-user credentials
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=tuanqsc@gmail.com
# App Password: vào https://myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_SMTP_PASSWORD=attvefqpsrfjtweq
GMAIL_FROM_EMAIL=tuanqsc@gmail.com
GMAIL_FROM_NAME=CinemaHub

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file: copy .env.example .env
# 2. Edit .env with your actual database credentials
# 3. The .env file is in .gitignore (not committed to git)
#
# Connection string format:
# jdbc:sqlserver://HOST\INSTANCE:PORT;databaseName=DBNAME;encrypt=false;trustServerCertificate=true
