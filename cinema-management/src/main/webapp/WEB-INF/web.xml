        <servlet-class>com.cinema.web.ShiftController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>shiftController</servlet-name>
        <url-pattern>/shift/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>reportController</servlet-name>
        <servlet-class>com.cinema.web.ReportController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>reportController</servlet-name>
        <url-pattern>/report/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>notificationController</servlet-name>
        <servlet-class>com.cinema.web.NotificationController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>notificationController</servlet-name>
        <url-pattern>/notification/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>walletController</servlet-name>
        <servlet-class>com.cinema.web.WalletController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>walletController</servlet-name>
        <url-pattern>/wallet/*</url-pattern>
    </servlet-mapping>
    <servlet>
