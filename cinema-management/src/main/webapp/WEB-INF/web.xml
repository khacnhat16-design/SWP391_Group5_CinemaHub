<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
    <display-name>Cinema Management</display-name>
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <listener>
        <listener-class>com.cinema.listener.AppContextListener</listener-class>
    </listener>
    <filter>
        <filter-name>exceptionMapping</filter-name>
        <filter-class>com.cinema.filter.ExceptionMappingFilter</filter-class>
    </filter>
    <filter>
        <filter-name>encoding</filter-name>
        <filter-class>com.cinema.filter.EncodingFilter</filter-class>
    </filter>
    <filter>
        <filter-name>csrf</filter-name>
        <filter-class>com.cinema.filter.CsrfFilter</filter-class>
    </filter>
    <filter>
        <filter-name>auth</filter-name>
        <filter-class>com.cinema.filter.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>branchScopeRbac</filter-name>
        <filter-class>com.cinema.filter.BranchScopeRBACFilter</filter-class>
    </filter>
    <filter>
        <filter-name>noCache</filter-name>
        <filter-class>com.cinema.filter.NoCacheFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>exceptionMapping</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>encoding</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>auth</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>branchScopeRbac</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>csrf</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>noCache</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Kết nối DB cấu hình tập trung trong com.cinema.util.DBUtil (SQL Server SQLEXPRESS) -->

    <!-- REST API controllers (design.md API contracts) -->
    <servlet>
        <servlet-name>sessionController</servlet-name>
        <servlet-class>com.cinema.web.SessionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>sessionController</servlet-name>
        <url-pattern>/api/session</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>profileController</servlet-name>
        <servlet-class>com.cinema.web.ProfileController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>profileController</servlet-name>
        <url-pattern>/api/profile</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>authController</servlet-name>
        <servlet-class>com.cinema.auth.AuthController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/admin/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet>
